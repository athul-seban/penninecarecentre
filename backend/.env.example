# App
PORT=3000
NODE_ENV=development

# PostgreSQL (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=pinninecaredb

# PostgreSQL (production — Neon connection string, takes priority over DB_* vars above)
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/pinninecaredb?sslmode=require

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS (production — comma-separated list of allowed frontend/admin origins)
# ALLOWED_ORIGINS=https://pinninecare.vercel.app,https://pinninecare-admin.vercel.app

# Vercel Blob (production media/CV storage — set automatically when you attach a Blob
# store to the project in the Vercel dashboard; leave unset locally to use local disk)
# BLOB_READ_WRITE_TOKEN=

# Cloudinary (legacy, unused unless CloudinaryService is re-wired)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin default credentials
ADMIN_EMAIL=admin@pinnineCare.com
ADMIN_PASSWORD=
