# App
PORT=3000
NODE_ENV=development

# PostgreSQL (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=pinninecaredb

# PostgreSQL (production — Neon connection string, takes priority over DB_* vars above)
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/pinninecaredb?sslmode=require

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS (production — comma-separated list of allowed frontend/admin origins)
# ALLOWED_ORIGINS=https://pinninecare.vercel.app,https://pinninecare-admin.vercel.app

# Media storage: uploaded images/videos are stored as binary data directly in
# Postgres (media.data) and served from GET /api/media/:id/raw. That route
# returns an absolute URL built from PUBLIC_API_URL (falls back to
# http://localhost:PORT in dev, or the pinninecare-api Vercel domain in prod
# when unset) — set this if your deployed API domain differs from that default.
# PUBLIC_API_URL=https://pinninecare-api.vercel.app

# Legacy media storage (Vercel Blob / local disk) — only still used to delete
# media rows uploaded before the switch to in-DB binary storage above.
# BLOB_READ_WRITE_TOKEN=

# Admin accounts — 3 named accounts are seeded on boot, one per ADMIN{1,2,3}_* set.
# Each is created with the 'admin' role (full access); roles/permissions and
# additional users can then be managed from Admin -> Users & Roles.
ADMIN1_NAME=Centre Director
ADMIN1_EMAIL=director@example.com
ADMIN1_PASSWORD=

ADMIN2_NAME=Care Manager
ADMIN2_EMAIL=care.manager@example.com
ADMIN2_PASSWORD=

ADMIN3_NAME=Operations Admin
ADMIN3_EMAIL=operations@example.com
ADMIN3_PASSWORD=
